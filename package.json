{
  "name": "grokbot-weixin",
  "version": "0.1.0",
  "description": "Bridge WeChat (Weixin) iLink bot messages to a Grok Bot routine webhook.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "grokbot-weixin": "./dist/node/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "wrangler.toml"
  ],
  "scripts": {
    "test": "vitest run",
    "build:node": "tsc -p tsconfig.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "build": "npm run build:node && npm run typecheck:worker && npm run build:worker",
    "start": "node dist/node/cli.js start"
  },
  "dependencies": {
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@types/node": "^22.19.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  }
}
