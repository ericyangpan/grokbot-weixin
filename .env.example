# Copy to .env for the Node runner. Do not commit .env.
# Worker secrets are set with `wrangler secret put`, not this file.
# Lines left empty fall back to the defaults in src/core/config.ts.

# iLink Bot API. QR login starts at ILINK_API_BASE. After login, the
# per-account baseurl from the confirm response is used when present.
ILINK_API_BASE=https://ilinkai.weixin.qq.com
ILINK_CDN_BASE=https://novac2c.cdn.weixin.qq.com/c2c
ILINK_BOT_TYPE=3
ILINK_APP_ID=bot
ILINK_CHANNEL_VERSION=0.1.0
ILINK_BOT_AGENT=GrokBotWeixin/0.1.0
# Optional. Sent as SKRouteTag when it matches [A-Za-z0-9_.:-]{1,64}.
ILINK_ROUTE_TAG=

# Optional seed. Leave empty to log in with `grokbot-weixin login` or /login.
# Both WEIXIN_BOT_TOKEN and WEIXIN_ACCOUNT_ID are required for a seed.
WEIXIN_BOT_TOKEN=
WEIXIN_ACCOUNT_ID=
WEIXIN_BASE_URL=
# Scanner id from a previous login. Pinned when the allowlist is empty.
WEIXIN_OWNER_USER_ID=

# Comma-separated sender ids. When set, this list replaces the stored allowlist.
# When empty and WEIXIN_PIN_FIRST_SENDER=true, the QR scanner (or the first
# inbound sender, if the scanner id was not returned) is pinned.
WEIXIN_ALLOW_FROM=
WEIXIN_PIN_FIRST_SENDER=true

# Grok Bot routine webhook. The header name is not documented by the routine
# panel in a stable way; confirm it there. Default is Authorization: Bearer <key>.
# Set GROK_WEBHOOK_SCHEME=raw to send the key with no scheme prefix.
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=
GROK_WEBHOOK_HEADER=Authorization
GROK_WEBHOOK_SCHEME=Bearer

# Public origin used in the webhook event's reply.url. For a tunnel or Worker
# this must be the internet URL, not the loopback address.
BRIDGE_PUBLIC_URL=
# Bearer token for /send, /login, and /admin/*. Generate with: openssl rand -base64 32
BRIDGE_TOKEN=

# Node HTTP server. Use 0.0.0.0 inside Docker. Keep 127.0.0.1 on a laptop.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787

SEND_TYPING=true
LONG_POLL_TIMEOUT_MS=35000
WEBHOOK_MAX_ATTEMPTS=4
RATE_LIMIT_SEND_PER_MINUTE=30

# Node only. Defaults to ~/.grokbot-weixin
GROKBOT_STATE_DIR=
